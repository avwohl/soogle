# Soogle environment configuration.
# Copy to .env and fill in real values.  Sourced by Django, the scrape CLI,
# and weekly.bash.

# --- Database ---
# Engine is auto-detected: MySQL if SOOGLE_DB_PASS is set, otherwise SQLite
# (a single file, no server).  Force one explicitly with SOOGLE_DB_ENGINE.
# SOOGLE_DB_ENGINE=mysql
SOOGLE_DB_PATH=soogle.db
# --- MySQL (only needed when using MySQL) ---
# SOOGLE_DB_HOST=127.0.0.1
# SOOGLE_DB_PORT=3306
# SOOGLE_DB_USER=root
# SOOGLE_DB_PASS=changeme
# SOOGLE_DB_NAME=soogle

# --- API keys (optional, depending on which scrapers you run) ---
GITHUB_TOKEN=
BRAVE_API_KEY=
SERPAPI_KEY=
BING_API_KEY=
ANTHROPIC_API_KEY=
# LLM review backend: set OPENAI_BASE_URL to any OpenAI-compatible endpoint
# (e.g. https://api.openai.com/v1); otherwise the Anthropic SDK is used.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=claude-haiku-4-5-20251001

# --- hCaptcha (used by /submit/ form) ---
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# --- Email notifications for new site submissions ---
SUBMISSION_EMAIL_TO=
SUBMISSION_EMAIL_FROM=noreply@soogle.org
EMAIL_HOST=localhost
EMAIL_PORT=25
